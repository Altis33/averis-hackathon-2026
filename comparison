# 1. Text Normalization
def normalize_text(text):
  """Cleans text by making it lowercase, removing extra spaces,

  and stripping basic punctuation.
  """
  if not text:
    return ""
  # Convert to lowercase and remove surrounding spaces
  cleaned = str(text).lower().strip()
  # Remove trailing periods or commas
  cleaned = cleaned.replace(".", "").replace(",", "")
  return cleaned

# 2. Number and Weight Normalization
def normalize_number(value):
  """Cleans weight or container count values for accurate comparison."""
  if value is None:
    return None
  try:
    # Convert to string, lowercase, and remove 'kg' or spaces
    cleaned = str(value).lower().replace("kg", "").replace(",", "").strip()
    return float(cleaned)
  except ValueError:
    # Return original if it can't be turned into a number
    return value